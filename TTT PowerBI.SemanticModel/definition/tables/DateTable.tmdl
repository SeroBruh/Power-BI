	column DayOfWeekNumber = ```
			WEEKDAY('DateTable'[Date], 2) 
			
			```
		formatString: 0
		lineageTag: f74247f5-397b-42bf-8834-c195c1dc71b5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition DateTable = calculated
		mode: import
		source = ```
				
				VAR MinYear = YEAR(MIN('bikeshare_trips'[start_date]))
				VAR MaxYear = YEAR(MAX('bikeshare_trips'[start_date]))
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( DATE ( MinYear, 1, 1 ), DATE ( MaxYear, 12, 31 ) ),
				    "Year", YEAR ( [Date] ),
				    "Quarter", "Q" & FORMAT ( [Date], "q" ),
				    "MonthNo", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "mmmm" ),
				    "YearMonthNo", INT(FORMAT([Date], "YYYYMM")),
				    "YearMonth", FORMAT ( [Date], "mmm YYYY" )
				)
				
				```

	annotation PBI_Id = f7d1654486a94b9eb6db2b9408d8400a

