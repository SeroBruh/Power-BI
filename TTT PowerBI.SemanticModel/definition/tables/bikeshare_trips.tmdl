	column trip = ```
			'bikeshare_trips'[start_station_name] & " --> " & 'bikeshare_trips'[end_station_name]
			
			```
		lineageTag: c7dc8ffe-c7d0-4c5d-b944-cd2380f370b5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column age_group = ```
			
			VAR age = 2026 - 'bikeshare_trips'[member_birth_year]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK('bikeshare_trips'[member_birth_year]), "Unknown",
			        age <= 25, "Under 25",
			        age <= 35, "26 - 35",
			        age <= 50, "36 - 50",
			        age <= 65, "51 - 65",
			        age <= 80, "66 - 80",
			        age > 80, "Over 80",
			        "Unknown"
			    )
			
			```
		lineageTag: 8ade9b2d-a8cd-4852-99f9-5de7455f7125
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

