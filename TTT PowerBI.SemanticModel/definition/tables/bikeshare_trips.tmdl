table bikeshare_trips
	lineageTag: 75e75c0d-66b7-44b2-8d13-bc14a77b6131

	measure trip_count = COUNTROWS(bikeshare_trips)
		formatString: 0
		lineageTag: 3310219e-bc06-4af8-9caf-73160778a613

	measure 'MoM % Change' = ```
			
			VAR CurrentPeriod = COUNTROWS(bikeshare_trips)
			VAR PreviousPeriod = CALCULATE(COUNTROWS(bikeshare_trips), DATEADD('DateTable'[Date], -1, MONTH),REMOVEFILTERS('DateTable'))
			RETURN
			    DIVIDE(CurrentPeriod - PreviousPeriod, PreviousPeriod, 0)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8eea770f-bab4-4e73-a863-c225b0493334

	measure 'QoQ % Change' = ```
			
			VAR CurrentPeriod = COUNTROWS(bikeshare_trips)
			VAR PreviousPeriod = CALCULATE(COUNTROWS(bikeshare_trips), DATEADD('DateTable'[Date], -1, QUARTER),REMOVEFILTERS('DateTable'))
			RETURN
			    DIVIDE(CurrentPeriod - PreviousPeriod, PreviousPeriod, 0)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2ac47ae2-771c-43d8-be39-434e02287527

	measure 'YoY % Change' = ```
			
			VAR CurrentPeriod = COUNTROWS('bikeshare_trips')
			VAR PreviousPeriod = CALCULATE(COUNTROWS('bikeshare_trips'), DATEADD('DateTable'[Date], -1, YEAR),REMOVEFILTERS('DateTable'))
			RETURN
			    DIVIDE(CurrentPeriod - PreviousPeriod, PreviousPeriod, 0)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 96bdf8e4-9bc5-4905-9e05-8a8a4aafdfa1

	measure daily_trips_average =
			DIVIDE(
			    CALCULATE(COUNTROWS('bikeshare_trips'), ALL('bikeshare_trips')),
			    CALCULATE(COUNTROWS('DateTable'), ALL('DateTable')),
			    0
			)
		lineageTag: a8cbe78c-6183-4821-b74a-592a2f578cf8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AVGDuration = ```
			AVERAGE('bikeshare_trips'[duration_sec])
			
			```
		lineageTag: 8649e2f5-42f3-4a8c-8068-04ef96afb406

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hourly Volume' =
			
			CALCULATE(
			    COUNTROWS('bikeshare_trips'),
			    REMOVEFILTERS('DateTable')
			)
		formatString: 0
		lineageTag: 2879957d-a9a2-45cf-94c9-ec329ee0e59c

	measure sanjose =
			CALCULATE(
			    COUNTROWS('bikeshare_trips'),
			    REMOVEFILTERS('DateTable'[Year]),
			    REMOVEFILTERS('DateTable'[Quarter]),
			    'bikeshare_regions'[name] = "San Jose"
			)
		formatString: 0
		lineageTag: 23635ded-a4aa-4f5f-a154-de9ab416106f

